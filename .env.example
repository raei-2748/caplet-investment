# Environment Variables Example for wharton-ic
# Copy this file to .env and populate your keys if available.
# The system operates 100% deterministically without API keys via built-in mock fallbacks.

# LLM Providers (Optional for Council Debate; Mock fallback enabled if omitted)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Data Providers (Optional)
FRED_API_KEY=""
SEC_EDGAR_USER_AGENT="WhartonICTeam student_research@wharton-ic.org"

# System Execution Settings
WHARTON_IC_ENV="development"
WHARTON_IC_STRICT_POINT_IN_TIME="true"
